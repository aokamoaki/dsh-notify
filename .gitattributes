# Set default behavior to normalize line endings on check-in.
* text=auto

# JavaScript / JSON / YAML / Markdown / scripts
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.ps1   text eol=crlf

# Binaries
*.png   binary
*.ico   binary
*.jpg   binary
*.svg   text eol=lf
